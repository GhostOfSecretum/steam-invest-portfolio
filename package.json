{
  "name": "steam-invest-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Local MVP for CS2 skin portfolio tracking with Steam login and real market data.",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:dist:mac": "npm --prefix desktop run dist:mac",
    "desktop:dist:win": "npm --prefix desktop run dist:win",
    "telegram:session": "node scripts/create-telegram-session.js",
    "telegram:session:apply": "node scripts/apply-telegram-session.js",
    "xray:config": "node scripts/generate-xray-config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "openid": "^2.0.15",
    "telegram": "^2.26.22"
  }
}
