{
  "name": "steam-invest-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Local MVP for CS2 skin portfolio tracking with Steam login and real market data.",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:dist:mac": "npm --prefix desktop run dist:mac",
    "desktop:dist:win": "npm --prefix desktop run dist:win",
    "telegram:session": "node scripts/create-telegram-session.js",
    "telegram:session:apply": "node scripts/apply-telegram-session.js",
    "telegram:topic-links": "node scripts/extract-telegram-topic-links.js",
    "top-investors:import": "node scripts/import-top-investors-from-file.js",
    "top-investors:baseline": "node scripts/baseline-top-investors-activity.js",
    "start": "node server/index.js",
    "x-desk": "node scripts/x-desk.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "telegram": "^2.26.22"
  }
}
