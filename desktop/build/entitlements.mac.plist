<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Deliberately narrower than electron-builder's default entitlements.
		V8 needs both JIT entitlements. Everything else is left out on purpose:
		the packaged app ships no native (.node) modules, so library validation
		stays enabled, and nothing reads DYLD_* variables.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
