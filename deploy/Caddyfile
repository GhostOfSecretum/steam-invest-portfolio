# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
www.skinshead.pro {
	redir https://skinshead.pro{uri} permanent
}

skinshead.pro {
	encode gzip
	# The app and the private X desk run on this host, plain HTTP, bound to localhost.
	route {
		redir /x-desk /x-desk/ permanent
		handle_path /x-desk/* {
			reverse_proxy 127.0.0.1:3847
		}
		reverse_proxy 127.0.0.1:3000
	}
}
