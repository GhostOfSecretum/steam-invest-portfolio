PORT=3000
# Leave empty to use the URL you open in the browser (recommended).
# Set only behind a reverse proxy when Host/X-Forwarded-* headers are wrong.
# APP_BASE_URL=https://your-domain.com
# TRUST_PROXY=true
SESSION_SECRET=replace-with-a-long-random-local-secret
STEAM_API_KEY=
PRICEMPIRE_API_KEY=
# CSMarketAPI key — cheaper alternative to PriceEmpire for price history charts.
# Free plan: 1,000 req/month. Pro plan: $9.99/month for 1,000,000 req/month (11+ years of history).
# Get your key at: https://csmarketapi.com
CSMARKET_API_KEY=
# Catalog source: steam (default) or csmarketapi (uses /v1/items/ + Steam listings via CSMarketAPI).
MARKET_CATALOG_PROVIDER=csmarketapi
# Official CSFloat Market API key. Enables live CSFloat prices in the item-detail
# "Marketplace prices" list (otherwise CSFloat shows as a buy-link only).
CSFLOAT_API_KEY=
# LIS-Skins partner API key. Enables live LIS-Skins prices in the item-detail
# "Marketplace prices" list (falls back to the public csgo.json dump without it).
# Get your key at: https://lis-skins.com/ (account settings → API).
LISSKINS_API_KEY=
# Optional LIS-Skins USD→RUB rate override (e.g. 76.5) when API does not return native RUB.
# If unset, the app tries currency=RUB on the API and otherwise falls back to CBR.
LISSKINS_RUB_PER_USD=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Optional one-shot login helpers for npm run telegram:session
TELEGRAM_PHONE=
TELEGRAM_CODE=
TELEGRAM_PASSWORD=
# Comma-separated public usernames or invite links, for example: csgomarket,https://t.me/+inviteHash
TELEGRAM_CHANNELS=
TELEGRAM_POSTS_PER_CHANNEL=20
# Route only Telegram news through a local SOCKS5 proxy (not MTProxy).
# In docker-compose this defaults to the xray sidecar: xray:1080
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=1080
# VLESS VPN used by the xray sidecar. Set VLESS_URL or the fields below.
# VLESS_URL=vless://uuid@host:port?security=reality&sni=...&pbk=...&sid=...&type=grpc
VLESS_URL=
VLESS_SERVER=
VLESS_PORT=2096
VLESS_UUID=
VLESS_SNI=
VLESS_PUBLIC_KEY=
VLESS_SHORT_ID=
VLESS_FINGERPRINT=chrome
VLESS_GRPC_SERVICE_NAME=
XRAY_SOCKS_PORT=1080
XRAY_CONFIG_PATH=xray/config.json
NEWS_MAX_ITEMS=50
